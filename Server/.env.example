PORT=3600

# --- Likes: Upstash Redis (Vercel injects these when you connect the database).
# Locally, without them, likes are kept in memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# LIKES_SALT=any-secret-text

# --- CORS: only needed if the front end is hosted on a different domain.
# Comma separated list. Empty = same-origin only (default Vercel setup).
# ALLOWED_ORIGINS=https://my-site.example.com

# --- Contact form email (SMTP) ---
# Gmail: enable 2-Step Verification and create an App Password
# (Google Account > Security > App passwords). Use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=roberpalestini97@gmail.com
SMTP_PASS=<16-char-app-password>
# Sender shown in the emails (must be allowed by the SMTP account)
MAIL_FROM="Portfolio <roberpalestini97@gmail.com>"
# Inbox that receives the contact requests (defaults to roberpalestini97@gmail.com)
CONTACT_TO=roberpalestini97@gmail.com
# Send a "thanks" copy to visitors who leave an email (true/false)
SEND_CONFIRMATION=true
# Set to "json" to build emails without sending them (tests / local dev)
# MAIL_TRANSPORT=json
